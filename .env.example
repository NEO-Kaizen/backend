PORT=3000
JWT_SECRET=my-super-secret-key-change-in-production
JWT_EXPIRES_IN=1d
NODE_ENV=development

# Local: localhost. No Docker, o compose sobrescreve para o serviço postgres.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=neo_dev
DB_USER=neo_dev
DB_PASSWORD=neo_dev

# Porta local do PostgreSQL publicada pelo compose (padrão 5432)
# POSTGRES_HOST_PORT=5432

#Origins separadas por ,
CORS_ORIGINS=http://localhost:5173
COOKIE_NAME=session_id