PORT=3000
JWT_SECRET=my-super-secret-key-change-in-production
JWT_EXPIRES_IN=1d
# Chave do FPE/Feistel usada para gerar o protocolo não enumerável.
# Obrigatória em produção (o boot falha se ausente); em dev há um default local.
PROTOCOL_FPE_KEY=my-fpe-secret-key-change-in-production
NODE_ENV=development

# Local: localhost. No Docker, o compose sobrescreve DB_HOST para o serviço
# postgres e DB_PORT para 5432 dentro da rede.
DB_HOST=localhost
# Porta do PostgreSQL no host (publicada pelo compose e usada pelos comandos
# npm fora do container). Se a 5432 estiver ocupada, defina outra porta aqui.
DB_PORT=5432
DB_NAME=neo_dev
DB_USER=neo_dev
DB_PASSWORD=neo_dev

#Origins separadas por ,
CORS_ORIGINS=http://localhost:5173
COOKIE_NAME=session_id