    "start": "node --env-file=.env src/server.ts",
    "dev": "node --env-file=.env --watch src/server.ts",
    "build": "tsc",
    "start:prod": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format:check",
