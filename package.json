  },
  "homepage": "https://github.com/NEO-Kaizen/backend#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "prettier": "3.9.6",
    "typescript-eslint": "^8.66.0"
  },
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
