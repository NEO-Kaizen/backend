{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "build": "tsc",
    "start:prod": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "test": "echo \"No tests configured yet\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate:make": "knex migrate:make --env development",
    "migrate:latest": "knex migrate:latest --env development",
    "migrate:rollback": "knex migrate:rollback --env development",
    "docker:dev": "docker compose up --build",
    "docker:migrate:latest": "docker compose exec app npm run migrate:latest",
    "docker:migrate:rollback": "docker compose exec app npm run migrate:rollback",
    "docker:migrate:make": "docker compose exec app npm run migrate:make --"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NEO-Kaizen/backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bugs": {
    "url": "https://github.com/NEO-Kaizen/backend/issues"
  },
  "homepage": "https://github.com/NEO-Kaizen/backend#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "prettier": "3.9.6",
    "typescript-eslint": "^8.66.0"
  },
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "multer": "^2.3.0",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  }
}
